[Unit]
Description=Streamlit Dashboard - Radar Parlamentar
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/dashboard_rag_camara
ExecStart=/home/ubuntu/dashboard_rag_camara/.venv/bin/python -m streamlit run app.py --server.port 8501 --server.address 0.0.0.0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target